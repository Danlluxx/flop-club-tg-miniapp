# Domain without protocol. DNS A-record must point to the VPS IP.
APP_DOMAIN=mini.flopclub.ru

# PostgreSQL inside docker-compose.prod.yml
POSTGRES_DB=flop_club
POSTGRES_USER=flop_user
POSTGRES_PASSWORD=change_this_strong_password

# Backend
DATABASE_URL=postgresql://flop_user:change_this_strong_password@postgres:5432/flop_club?schema=public
PORT=4000
NODE_ENV=production
BOT_TOKEN=123456:telegram-bot-token
JWT_SECRET=change_this_to_a_very_long_random_secret_min_24_chars
FRONTEND_URL=https://mini.flopclub.ru
ADMIN_TELEGRAM_USERNAMES=danIIuxx
ALLOW_CANCEL_AFTER_CLOSE=false

# Frontend build-time values
# Empty VITE_API_URL means same-origin requests: https://mini.flopclub.ru/api/...
VITE_API_URL=
VITE_SUPPORT_URL=https://t.me/flopclub
