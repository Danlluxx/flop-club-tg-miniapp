# Domain without protocol. DNS A-record must point to the VPS IP.
APP_DOMAIN=186.246.4.246.sslip.io

# Token of the remotely-managed Cloudflare Tunnel serving mini.flopclub.ru.
# Keep this value secret and never commit the production token.
CLOUDFLARE_TUNNEL_TOKEN=

# PostgreSQL inside docker-compose.prod.yml
POSTGRES_DB=flop_club
POSTGRES_USER=flop_user
POSTGRES_PASSWORD=change_this_strong_password

# Backend
DATABASE_URL=postgresql://flop_user:change_this_strong_password@postgres:5432/flop_club?schema=public
PORT=4000
NODE_ENV=production
BOT_TOKEN=123456:telegram-bot-token
JWT_SECRET=change_this_to_a_very_long_random_secret_min_24_chars
FRONTEND_URL=https://186.246.4.246.sslip.io
ADDITIONAL_FRONTEND_URLS=
ADMIN_TELEGRAM_USERNAMES=danIIuxx
TELEGRAM_REMINDER_CHAT_ID=
TELEGRAM_RATING_CHAT_ID=@flopclub
TOURNAMENT_REMINDER_BROADCAST_USERS=true
TOURNAMENT_REMINDERS_ENABLED=true
ALLOW_CANCEL_AFTER_CLOSE=false
CLOCK_API_TOKEN=change_this_clock_api_token
PAYROLL_TELEGRAM_USERNAMES=danlluxx
PAYROLL_REPORT_HOUR=6

# Frontend build-time values
# Empty VITE_API_URL means same-origin requests: https://mini.flopclub.ru/api/...
VITE_API_URL=
VITE_SUPPORT_URL=https://t.me/flopclub
VITE_TELEGRAM_BOT_USERNAME=FlopClubBot
# Optional BotFather Mini App short name. Leave empty if the main bot Mini App is used.

# Blind clock
BLIND_TELEGRAM_BOT_TOKEN=
BLIND_TELEGRAM_ALLOWED_CHAT_ID=
BLIND_BRIDGE_COMMAND_TOKEN=change_this_blind_command_token
BLIND_FLOP_CLUB_TG_TOURNAMENT_ID=
